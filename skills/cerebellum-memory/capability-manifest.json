{
  "schema": 1,
  "module": "cerebellum-memory",
  "version": "1.0.0",
  "capabilities": [
    "procedural_calibration",
    "precision_tracking",
    "smoothness_ema"
  ],
  "inputs": [
    {
      "name": "execution_events",
      "type": "event",
      "source": "workspace/events"
    },
    {
      "name": "cerebellum_state",
      "type": "state_file",
      "source": "memory/cerebellum-state.json",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "cerebellum_state",
      "type": "state_write",
      "target": "memory/cerebellum-state.json"
    }
  ],
  "side_effects": [
    "writes_shared_state",
    "filesystem_write"
  ],
  "dependencies": [
    {
      "module": "basal-ganglia-memory",
      "version_constraint": ">=0.2.0"
    }
  ],
  "tests": [
    {
      "path": "tests/run_phase1_harness.sh",
      "kind": "regression"
    },
    {
      "path": "tests/test_cerebellum_calibration.sh",
      "kind": "unit"
    }
  ],
  "immutable": false
}
