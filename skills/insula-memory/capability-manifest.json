{
  "schema": 1,
  "module": "insula-memory",
  "version": "0.3.0",
  "capabilities": [
    "interoception",
    "cognitive_load_sensing",
    "context_saturation",
    "interoceptive_prediction_error"
  ],
  "inputs": [
    {
      "name": "sense_events",
      "type": "event",
      "source": "workspace/events"
    },
    {
      "name": "interoceptive_state",
      "type": "state_file",
      "source": "memory/interoceptive-state.json",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "interoceptive_state",
      "type": "state_write",
      "target": "memory/interoceptive-state.json"
    }
  ],
  "side_effects": [
    "writes_shared_state",
    "filesystem_write"
  ],
  "dependencies": [],
  "tests": [
    {
      "path": "tests/run_phase1_harness.sh",
      "kind": "regression"
    },
    {
      "path": "tests/test_insula_state.sh",
      "kind": "unit"
    },
    {
      "path": "tests/test_insula_discrepancy.sh",
      "kind": "unit"
    }
  ],
  "immutable": false
}
