{
  "capabilities": [
    "systemic_clearance",
    "backlog_age_audit",
    "deadletter_review",
    "stale_lease_reaping",
    "orphan_store_reporting"
  ],
  "dependencies": [],
  "inputs": [
    {
      "name": "flow_registry",
      "source": "core/gate/flows.json",
      "type": "state_file"
    },
    {
      "name": "queue_stores",
      "required": false,
      "source": "memory/pending-*.json",
      "type": "state_file"
    },
    {
      "name": "deadletter",
      "required": false,
      "source": "~/.openclaw/queue/deadletter",
      "type": "state_file"
    },
    {
      "name": "gate_leases",
      "required": false,
      "source": "memory/gate-leases",
      "type": "state_file"
    }
  ],
  "module": "glymphatic-memory",
  "outputs": [
    {
      "name": "glymphatic_state",
      "target": "memory/glymphatic-state.json",
      "type": "state_write"
    },
    {
      "name": "clearance_ledger",
      "target": "memory/clearance-ledger.jsonl",
      "type": "log_entry"
    },
    {
      "name": "clearance_archive",
      "target": "memory/clearance-archive/",
      "type": "state_write"
    }
  ],
  "schema": 1,
  "side_effects": [
    "writes_shared_state",
    "filesystem_write"
  ],
  "tests": [
    {
      "kind": "unit",
      "path": "tests/test_glymphatic_clearance.sh"
    }
  ],
  "version": "1.0.0",
  "immutable": false
}
