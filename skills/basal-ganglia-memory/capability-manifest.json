{
  "schema": 1,
  "module": "basal-ganglia-memory",
  "version": "0.3.0",
  "capabilities": [
    "habit_encoding",
    "habit_reinforcement",
    "habit_decay",
    "selection_threshold_gating"
  ],
  "inputs": [
    {
      "name": "habit_events",
      "type": "event",
      "source": "workspace/events"
    },
    {
      "name": "habit_state",
      "type": "state_file",
      "source": "memory/habit-state.json",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "habit_state",
      "type": "state_write",
      "target": "memory/habit-state.json"
    }
  ],
  "side_effects": [
    "writes_shared_state",
    "spawns_inference",
    "filesystem_write"
  ],
  "dependencies": [],
  "tests": [
    {
      "path": "tests/run_phase1_harness.sh",
      "kind": "regression"
    },
    {
      "path": "tests/test_basal_ganglia_habits.sh",
      "kind": "unit"
    },
    {
      "path": "tests/test_bg_threshold.sh",
      "kind": "unit"
    }
  ],
  "immutable": false
}
